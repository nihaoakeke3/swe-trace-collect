# swe-trace-collect configuration (sourced by bash scripts, parsed by freetoken_trace.config)
# Copy this file to config.env and fill in your environment. Do NOT commit config.env.

RUN_ID=r1

# --- serving engine (any Anthropic /v1/messages compatible backend) ---
# vLLM example: point VLLM_PYTHON at a venv with vllm installed
MODEL_PATH=/path/to/model                      # HF checkpoint dir
SERVED_MODEL_NAME=my-model                     # must match the engine's --served-model-name
VLLM_PYTHON=/path/to/swe-trace-collect/venvs/vllm/bin/python
GPU_ID=1
VLLM_PORT=1923
MAX_MODEL_LEN=131072                           # engine context length
GPU_MEM_UTIL=0.90
MAX_NUM_SEQS=16
TOOL_CALL_PARSER=qwen3_coder                  # match your model's tool-call format

# --- capture proxy ---
PROXY_PORT=1924
PROXY_UPSTREAM=http://127.0.0.1:1923           # the engine endpoint
PING_INTERVAL_S=15
UPSTREAM_SOCK_READ_TIMEOUT_S=660

# --- claude code driver ---
CLAUDE_BIN=/usr/local/bin/claude               # claude CLI path
MAX_TURNS=60
MAX_CONTEXT_TOKENS=200000                      # CLAUDE_CODE_MAX_CONTEXT_TOKENS
MAX_OUTPUT_TOKENS=32000
SILENCE_TIMEOUT_MIN=30
WALL_TIMEOUT_MIN=150
API_TIMEOUT_MS=600000

# --- dataset ---
HF_MIRROR=https://hf-mirror.com                # use https://huggingface.co if reachable
DATASET_REPO=ScaleAI/SWE-bench_Pro
NUM_TASKS=20
SMOKE_TASKS=3

# --- hygiene ---
CLEANUP_WORKSPACE=1
