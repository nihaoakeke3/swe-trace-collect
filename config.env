# swe-trace-collect central config (sourced by bash scripts, parsed by freetoken_trace.config)
# Keep all tunables here; no other file should hardcode ports/paths.

RUN_ID=r1

# --- serving ---
MODEL_PATH=/home/jinshuai/models/Qwen3.6-35B-A3B-AWQ-NVFP4
SERVED_MODEL_NAME=qwen3.6-35b-a3b-awq-nvfp4
VLLM_PYTHON=/home/jinshuai/code/swe-trace-collect/venvs/vllm/bin/python
GPU_ID=1
VLLM_PORT=1923
MAX_MODEL_LEN=262144
GPU_MEM_UTIL=0.92
MAX_NUM_SEQS=16
TOOL_CALL_PARSER=qwen3_coder

# --- capture proxy ---
PROXY_PORT=1924
PROXY_UPSTREAM=http://127.0.0.1:1923
PING_INTERVAL_S=15
UPSTREAM_SOCK_READ_TIMEOUT_S=660

# --- claude code driver ---
CLAUDE_BIN=/home/jinshuai/.npm-global/bin/claude
MAX_TURNS=60
MAX_CONTEXT_TOKENS=200000
MAX_OUTPUT_TOKENS=32000
SILENCE_TIMEOUT_MIN=30
WALL_TIMEOUT_MIN=150
API_TIMEOUT_MS=600000

# --- dataset ---
HF_MIRROR=https://hf-mirror.com
DATASET_REPO=ScaleAI/SWE-bench_Pro
NUM_TASKS=20
SMOKE_TASKS=3

# --- hygiene ---
CLEANUP_WORKSPACE=1
